# ExamFlow Environment Configuration

# Server Port
PORT=3000

# Strong JWT Secret (min 24 characters)
JWT_SECRET=production_super_strong_jwt_secret_key_minimum_24_chars_examflow_2026

# PostgreSQL Connection URI (e.g. from Render, Railway, Supabase, Neon, or local)
DATABASE_URL=postgres://user:password@hostname:5432/examflow?sslmode=require

# Initial Admin Credentials
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=SetAStrongPassword123!
